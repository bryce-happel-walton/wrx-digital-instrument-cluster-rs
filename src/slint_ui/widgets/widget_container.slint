import { ScrollView } from "std-widgets.slint";

import {
    Button,
    ControlledFocusScope,
    FocusDomain,
    FocusState,
    Label,
} from "@lib/core.slint";
import { DebugMenuWidget, DebugMenuState } from "debug.slint";
import {
    RoadIndicatorWidget,
} from "@themes/default/components/road_indicators.slint";
import {
    ApplicationState,
    DebugSettings,
    GeneralSettings,
    AccessibilitySettings,
} from "@lib/state.slint";
import { CanDisplayWidget } from "@widgets/can_display.slint";
import { CarDisplayWidget } from "@widgets/car_display.slint";
import { GlobalAnimation, DebugHighlight } from "@lib/core.slint";
import { DebugInfo, DebugInfoLabel } from "../lib/core.slint";
import { WidgetSettings } from "../lib/state.slint";
import { AcquisitionProgress, AcquisitionProgressWidget } from "acquisition_progress.slint";

export global WidgetContainerState {
    in-out property <int> current-page: 0;
    callback update-current-page(int);

    in-out property <int> focused-page: -1; // -1 if not entered

    out property <int> num-pages: 0;

    public function change-page(to-page: int) {
        current-page = to-page;
        update-current-page(to-page);
        self.exit-page();
    }

    public function focus-page(to-page: int) {
        self.change-page(to-page);
        self.focused-page = self.current-page;
    }

    public function exit-page() {
        self.focused-page = -1;
    }

    public function make-page() -> int {
        self.num-pages += 1;
        self.num-pages - 1
    }

    public function clear-pages() {
        self.num-pages = 0;
    }
}

export component Widget inherits FocusDomain {
    in-out property <bool> focusable: false;
    in property <image> icon: @image-url("@svg/abs-warning-light.svg");
    out property <int> page-number;
    out property <bool> has-focus: WidgetContainerState.focused-page == self.page-number;

    force-exit-strategy: self.focusable;
    force-focus: false;
    height: 100%;
    width: 100%;

    changed has-focus => {
        if focusable && has-focus {
            self.no-graceful-return = true;
            self.enter-domain();
        } else {
            WidgetContainerState.focused-page = -1;
        }
    }

    init => {
        self.page-number = WidgetContainerState.make-page();
    }

    exited => WidgetContainerState.exit-page();
}

export component FocusableWidget inherits Widget {
    focusable: true;
}

export component SettingsMenuWidget inherits FocusableWidget {
    nav-front-forward => settings-button.focus();

    HorizontalLayout {
        alignment: center;
        padding: 20px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                settings-button := Button {
                    text: "Settings";

                    activated => {
                        ApplicationState.settings-menu-visible = !ApplicationState.settings-menu-visible;
                    }
                }
            }
        }
    }
}

export component WidgetContainer inherits Rectangle {
    forward-focus: center-widget-container-indicator;

    // the acquisition summary owns the container until it has been up long enough to read
    private property <bool> acquiring: AcquisitionProgress.blocking;
    private property <bool> acquisition-complete: AcquisitionProgress.complete;
    // latched so the summary can finish fading out before the widgets come back
    private property <bool> showing-acquisition: false;

    init => {
        WidgetContainerState.clear-pages();
        root.showing-acquisition = AcquisitionProgress.blocking;
    }

    changed acquiring => {
        if acquiring {
            root.showing-acquisition = true;
        }
    }

    changed acquisition-complete => {
        if !acquisition-complete { // a new batch re-arms the hold
            AcquisitionProgress.holding = true;
        }
    }

    acquisition-hold-timer := Timer {
        interval: AcquisitionProgress.hold-duration;
        // bound rather than started, so a container built mid-hold still counts it down
        running: AcquisitionProgress.complete && AcquisitionProgress.holding;

        triggered => {
            AcquisitionProgress.holding = false;
        }
    }

    widget-container-widgets := Rectangle {
        opacity: root.acquiring ? 0 : 1;

        animate opacity {
            duration: GlobalAnimation.acquisition-fade-duration;
            easing: ease-in-out;
        }

        VerticalLayout {
            center-widget-container-indicator := FocusDomain {
                property <int> current-page: WidgetContainerState.current-page;
                property <length> indicator-width: self.height;

                height: 10%;
                force-exit-strategy: false;
                force-focus: true;

                nav-front-forward => WidgetContainerState.change-page(0);
                nav-end-backward => WidgetContainerState.change-page(WidgetContainerState.num-pages - 1);

                HorizontalLayout {
                    alignment: center;
                    spacing: FocusState.focus-highlight-size;
                    padding: FocusState.focus-highlight-size;

                    private property <bool> initialized-focus: false;

                    for i in WidgetContainerState.num-pages: Rectangle {
                        private property <bool> has-view: WidgetContainerState.current-page == i;
                        private property <bool> domain-active: center-widget-container-indicator.domain-active;

                        height: 100%;
                        width: self.height;
                        forward-focus: i-focus;

                        function attempt-focus() {
                            if domain-active && has-view && !i-focus.has-focus {
                                i-focus.focus();
                            }
                        }

                        changed has-view => {
                            attempt-focus();
                        }

                        changed domain-active => {
                            attempt-focus();
                        }

                        init => {
                            if (i == 0) && ((WidgetContainerState.current-page >= WidgetContainerState.num-pages) || (WidgetContainerState.current-page < 0)) {
                                i-focus.focus();
                            } else {
                                attempt-focus();
                            }
                        }

                        Text {
                            color: white;
                            text: i + 1;
                        }

                        i-focus := ControlledFocusScope {
                            init-focus: false;

                            focus-gained => {
                                if !has-view { // prevent dirty-ing the number and causing recursion
                                    WidgetContainerState.change-page(i);
                                }
                            }

                            activated => WidgetContainerState.focus-page(i);
                        }
                    }
                }
            }

            center-widget-container-inner := Rectangle {
                width: 80%;
                height: 90%;

                clip: true;

                center-widget-container-layout := HorizontalLayout {
                    x: (-WidgetContainerState.current-page * self.width) - (self.spacing * WidgetContainerState.current-page);

                    animate x {
                        duration: GlobalAnimation.page-duration;
                        easing: ease-in-out;
                    }

                    @children
                }
            }
        }
    }

    if root.showing-acquisition: acquisition-container := FocusDomain {
        force-exit-strategy: false;
        force-focus: true;

        // navigating out of the summary has nowhere to go but back into it
        nav-front-forward => acquisition-focus.focus();
        nav-end-backward => acquisition-focus.focus();

        opacity: root.acquiring ? 1 : 0;

        animate opacity {
            duration: GlobalAnimation.acquisition-fade-duration;
            easing: ease-in-out;
        }

        changed opacity => {
            if self.opacity == 0 { // hand the container back once the summary is gone
                center-widget-container-indicator.no-graceful-return = true;
                self.exit-domain();
                root.showing-acquisition = false;
            }
        }

        acquisition-focus := ControlledFocusScope {
            VerticalLayout {
                alignment: center;
                padding-left: root.width * 10%;
                padding-right: root.width * 10%;

                AcquisitionProgressWidget {
                    show-when-idle: true;
                }
            }
        }
    }
}

export component DefaultWidgetContainer inherits WidgetContainer {
    car-display-widget := Widget {
        CarDisplayWidget {
            height: 70%;
            width: 100%;
        }
    }

    road-indicator-widget := Widget {
        RoadIndicatorWidget {
            height: 100%;
            width: 100%;
        }
    }

    settings-menu-widget := SettingsMenuWidget { }

    FocusableWidget {
        nav-front-forward => FocusState.force-focus(can-display-widget.first-focus-id);
        nav-end-backward => FocusState.force-focus(can-display-widget.last-focus-id);

        can-display-widget := CanDisplayWidget {
            running: parent.has-focus && (WidgetContainerState.current-page == parent.page-number);
            height: 100%;
            width: 100%;
        }

        if !self.has-focus: Rectangle {
            height: 80%;
            width: 80%;

            background: black.transparentize(5%);
            Text {
                text: "Enter to run";
                font-size: 25px;
            }
        }
    }

    if DebugSettings.debug-mode: FocusableWidget {
        nav-front-forward => debug-menu-widget.focus();

        VerticalLayout {
            debug-menu-widget := DebugMenuWidget {
                height: 100%;
                width: 100%;
            }
        }
    }
}



export component WidgetContainerStateDebugModule inherits VerticalLayout {
    Text {
        color: purple;
        text: "WidgetContainerState";
    }

    Text {
        color: white;
        text: "current-page: " + WidgetContainerState.current-page;
    }

    Text {
        color: white;
        text: "focused-page: " + WidgetContainerState.focused-page;
    }

    Text {
        color: white;
        text: "num-pages: " + WidgetContainerState.num-pages;
    }
}
