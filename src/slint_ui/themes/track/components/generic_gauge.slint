import { SFDataParameter, SIDataParameter } from "@data/data_parameter.slint";
import { SymbolLight } from "@themes/default/components/common.slint";
import { SymbolProperties } from "@themes/default/symbol_properties.slint";


export component PillGauge inherits Rectangle {
    in property <SFDataParameter> data-parameter;
    private property <float> radius: min(self.height / 2px, self.width / 2px);
    in property <float> progress: data-parameter.value / data-parameter.max;
    in property <float> line-thickness: 2;
    in property <float> bar-padding: 2;

    outline := Path {
        fill: white;
        viewbox-height: root.height / 1px;
        viewbox-width: root.width / 1px;

        MoveTo {
            x: radius;
            y: 0;
        }

        ArcTo {
            radius-x: 1;
            radius-y: 1;
            x: radius;
            y: radius * 2;
        }

        LineTo {
            x: radius;
            y: radius * 2 - line-thickness;
        }

        ArcTo {
            radius-x: 1;
            radius-y: 1;
            sweep: true;
            x: radius;
            y: line-thickness;
        }

        LineTo {
            x: root.width / 1px - radius;
            y: line-thickness;
        }

        ArcTo {
            radius-x: 1;
            radius-y: 1;
            sweep: true;
            x: root.width / 1px - radius;
            y: radius * 2 - line-thickness;
        }

        LineTo {
            x: radius;
            y: radius * 2 - line-thickness;
        }

        LineTo {
            x: radius;
            y: radius * 2;
        }

        LineTo {
            x: root.width / 1px - radius;
            y: radius * 2;
        }

        ArcTo {
            radius-x: 1;
            radius-y: 1;
            x: root.width / 1px - radius;
            y: 0;
        }
    }

    Rectangle {
        background: transparent;
        clip: true;
        x: (line-thickness) * 0.5px;
        height: root.height - (line-thickness + bar-padding) * 2px;
        property <length> max-bar-width: root.width - (line-thickness) * 0.5px;

        width: max-bar-width * root.progress;

        Path {
            height: parent.height;
            width: root.width;

            x: -parent.x;
            y: 0;

            fill: white;

            viewbox-height: self.height / 1px;
            viewbox-width: self.width / 1px;

            MoveTo {
                x: radius;
                y: 0;
            }

            ArcTo {
                radius-x: 1;
                radius-y: 1;

                x: radius;
                y: parent.viewbox-height;
            }

            LineTo {
                x: parent.viewbox-width - radius;
                y: parent.viewbox-height;
            }

            ArcTo {
                radius-x: 1;
                radius-y: 1;

                x: parent.viewbox-width - radius;
                y: 0;
            }
        }
    }

    @children
}

export enum SideAlignment { right, left }


export component BarGauge {
    in property <SideAlignment> alignment: left;
    in property <SFDataParameter> data-parameter;
    property <float> progress: data-parameter.value / data-parameter.max;
    in property <length> line-thickness: 2px;
    in property <float> bar-padding: 2;

    HorizontalLayout {
        width: 100%;
        spacing: 5px;

        Rectangle {
            height: 100%;
            width: line-thickness;
            background: white;
        }

        Rectangle {
            background: grey.transparentize(85%);
            Rectangle {
                x: (alignment == SideAlignment.left ? 0 : parent.width - root.progress * parent.width);
                background: white.mix(black, 75%);
                width: root.progress * parent.width;
            }
        }

        Rectangle {
            height: 100%;
            width: line-thickness;
            background: white;
        }
    }
}


export component GaugeContainer inherits Rectangle {
    in property <SFDataParameter> data-parameter <=> gauge.data-parameter;
    in property <image> image;
    in property <float> image-scale: 55%;
    in property <SideAlignment> alignment: left;

    i-layout := HorizontalLayout {
        spacing: 10px;

        if root.alignment == SideAlignment.left: SymbolLight {
            source: root.image;
            scale: root.image-scale;
            colorize: SymbolProperties.symbol_color_white;
        }

        gauge := BarGauge {
            alignment: root.alignment;
        }

        if root.alignment == SideAlignment.right: SymbolLight {
            source: root.image;
            scale: root.image-scale;
            colorize: SymbolProperties.symbol_color_white;
        }
    }
}
