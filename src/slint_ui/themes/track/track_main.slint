import { VerticalBox, ComboBox } from "std-widgets.slint";

import { Arc } from "@lib/core.slint";
import {
    InteriorBrightnessIndicator,
} from "@themes/default/components/car_interior_brightness_indicator.slint";
import { SymbolProperties } from "@themes/default/symbol_properties.slint";
import { SCarData } from "@gen/data/car_data.slint";
import { SFDataParameter, SIDataParameter } from "@data/data_parameter.slint";
import { SUnitSystem } from "@lib/units.slint";
import { DebugHighlight } from "@lib/core.slint";
import {
    ApplicationState,
    GeneralSettings,
} from "@lib/state.slint";
import {
    WidgetContainer,
    Widget,
    FocusableWidget,
    SettingsMenuWidget,
} from "@widgets/widget_container.slint";
import { Tachometer } from "components/tachometer.slint";
import { GaugeContainer } from "components/generic_gauge.slint";
import {
    Odometer,
    MtGearLabel,
    SymbolLight,
    RightTurnSignal,
    LeftTurnSignal,
    HeadlightIndicator,
    DriverSeatbeltIndicator,
    CheckEngineLight,
    OilPressureWarningLight,
} from "@themes/default/components/common.slint";
import {
    RoadIndicatorWidget,
} from "@themes/default/components/road_indicators.slint";
import { CarDisplayWidget } from "@widgets/car_display.slint";

component PrimarySection inherits Rectangle {
    background: transparent;

    DebugHighlight { }
}

export component SymbolLight inherits Image {
    in property <float> scale: 1;
    width: SymbolProperties.size * scale;
    height: SymbolProperties.size * scale;
    image-fit: ImageFit.contain;
    colorize: Colors.blueviolet;
}

export component TrackTheme inherits Rectangle {
    background: transparent;

    width: self.height * (1920 / 720);
    height: 720px;

    VerticalLayout {
        top-span := PrimarySection {
            height: SymbolProperties.size;

            InteriorBrightnessIndicator { }
        }

        mid-span := PrimarySection {
            VerticalLayout {
                Rectangle {
                    height: 30%;

                    tachometer := Tachometer {
                        width: 80%;
                        height: 70%;

                        Text {
                            font-size: 20px;
                            y: -self.height;
                            x: parent.width - self.width;
                            color: white.transparentize(85%);

                            text: "×1000";
                        }
                    }
                }

                Rectangle {
                    RoadIndicatorWidget {
                        y: parent.height - self.height * 0.75;
                        width: 35%;
                        height: 120%;
                    }

                    mt-gear-label := MtGearLabel {
                        y: parent.height / 2 - self.height * 0.85;
                        font-size: 165px;
                    }

                    speedometer-label := Text {
                        font-family: "JetBrains Mono";
                        y: mt-gear-label.y + mt-gear-label.height;
                        text: round(SCarData.vehicle_speed.value);
                        color: white;
                        font-size: 95px;
                        vertical-alignment: TextVerticalAlignment.center;
                        horizontal-alignment: TextHorizontalAlignment.center;
                    }

                    speedometer-unit-label := Text {
                        y: speedometer-label.y + speedometer-label.height;
                        x: speedometer-label.x + speedometer-label.width / 2 - self.width / 2;
                        text: SCarData.vehicle_speed.unit-str;
                        color: speedometer-label.color.transparentize(75%);
                        font-size: 25px;
                        horizontal-alignment: TextHorizontalAlignment.center;
                    }

                    left-turn-signal := LeftTurnSignal {
                        x: parent.width / 2 - self.width * 4;
                        y: parent.height / 2 - self.height * 1.75;
                    }

                    right-turn-signal := RightTurnSignal {
                        x: parent.width - left-turn-signal.x - left-turn-signal.width;
                        y: left-turn-signal.y;
                    }

                    WidgetContainer {
                        x: parent.width - parent.width * 30%;
                        height: parent.height * 90%;
                        width: 15%;

                        car-display-widget := Widget {
                            CarDisplayWidget {
                                height: 70%;
                                width: 100%;
                            }
                        }

                        SettingsMenuWidget { }
                    }
                }
            }
        }

        bottom-span := PrimarySection {
            i-left-gauge-stack := HorizontalLayout {
                alignment: start;
                padding: 25px;

                i-left-gauge-stack-vertical := VerticalLayout {
                    width: 20%;
                    spacing: 5px;
                    alignment: end;

                    coolant-temp-gauge := GaugeContainer {
                        data-parameter: SCarData.engine_coolant_temp;
                        image: @image-url("@images/coolant-temp-low-high-indicator-light.png");
                    }

                    oil-temp-gauge := GaugeContainer {
                        data-parameter: SCarData.engine_oil_temp;
                        image: @image-url("@svg/oil-pressure-warning-light.svg");
                    }
                }
            }

            i-right-gauge-stack := HorizontalLayout {
                padding: i-left-gauge-stack.padding;
                alignment: end;

                i-right-gauge-stack-vertical := VerticalLayout {
                    width: i-left-gauge-stack-vertical.width;
                    spacing: i-left-gauge-stack-vertical.spacing;
                    alignment: i-left-gauge-stack-vertical.alignment;

                    fuel-level-gauge := GaugeContainer {
                        data-parameter: SCarData.fuel_level;
                        image: @image-url("@images/lowfuel-warning-light.png");
                        alignment: right;
                    }
                }
            }

            odometer := Odometer { }

            i-left-indicator-stack := HorizontalLayout {
                padding: 10px;
                spacing: 5px;
                width: self.preferred-width;
                height: self.preferred-height;
                x: i-left-gauge-stack-vertical.x + i-left-gauge-stack-vertical.width + 40px;
                y: 0 + bottom-span.height - self.height;
                alignment: start;

                HeadlightIndicator { }

                DriverSeatbeltIndicator { }
            }

            i-right-indicator-stack := HorizontalLayout {
                padding: 10px;
                spacing: 5px;
                width: self.preferred-width;
                height: self.preferred-height;
                x: i-right-gauge-stack-vertical.x - self.width - 40px;
                y: 0 + bottom-span.height - self.height;
                alignment: end;

                CheckEngineLight { }

                OilPressureWarningLight { }
            }
        }
    }
}
