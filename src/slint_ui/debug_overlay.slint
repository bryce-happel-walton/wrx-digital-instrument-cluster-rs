import {
    FocusStateDebugModule,
} from "@lib/core.slint";
import {
    ApplicationStateDebugModule,
    BackendDebugModule,
    SystemInfoDebugModule,
} from "@lib/state.slint";
import { PerformanceDebugModule } from "@data/performance.slint";
import {
    WidgetContainerStateDebugModule,
} from "@widgets/widget_container.slint";
import {
    AcquisitionProgressDebugModule,
} from "@widgets/acquisition_progress.slint";

export component DebugOverlay {
    x: 0;
    y: 20px;
    z: 999999;

    HorizontalLayout {
        alignment: start;
        spacing: 20px;

        Rectangle {
            background: black.transparentize(20%);
            VerticalLayout {
                alignment: start;

                Text {
                    color: Colors.purple;
                    text: "UI DEBUG";
                }

                ApplicationStateDebugModule { }

                FocusStateDebugModule { }

                WidgetContainerStateDebugModule { }
            }
        }

        Rectangle {
            background: black.transparentize(20%);
            VerticalLayout {
                VerticalLayout {
                    alignment: start;

                    Text {
                        color: Colors.darkviolet;
                        text: "BACKEND DEBUG";
                    }

                    BackendDebugModule { }
                }

                VerticalLayout {
                    alignment: start;

                    Text {
                        color: Colors.blanchedalmond;
                        text: "CAN DEBUG";
                    }

                    AcquisitionProgressDebugModule { }
                }
            }
        }

        Rectangle {
            background: black.transparentize(20%);
            VerticalLayout {
                alignment: start;

                Text {
                    color: Colors.yellowgreen;
                    text: "SYSTEM DEBUG";
                }

                SystemInfoDebugModule { }
            }
        }

        Rectangle {
            background: black.transparentize(20%);
            VerticalLayout {
                alignment: start;

                Text {
                    color: Colors.moccasin;
                    text: "PERFORMANCE DEBUG";
                }

                PerformanceDebugModule { }
            }
        }
    }
}
